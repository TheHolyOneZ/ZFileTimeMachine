{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZFileTimeMachine",
  "version": "0.2.1",
  "identifier": "com.zfiletimemachine.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ZFileTimeMachine",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TheHolyOneZ",
    "copyright": "Copyright © 2026 TheHolyOneZ. Licensed under GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "Automatic, private version history for any folder on your computer.",
    "longDescription": "ZFileTimeMachine watches the folders you choose and saves a snapshot of every file each time it changes. Browse any file's history, see line-by-line diffs, and rewind to any earlier version in one click, or recover many files at once. Everything stays on your machine: no cloud, no account, no git required.",
    "homepage": "https://zsync.eu/zftm/",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
